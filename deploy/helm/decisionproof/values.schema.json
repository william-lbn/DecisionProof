{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 1, "description": "当前 FileStore 验证版仅允许单副本"},
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"type": "string"}
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "auth": {
      "type": "object",
      "required": ["mode", "allowInsecureDevelopmentHeaders", "oidc"],
      "properties": {
        "mode": {"type": "string", "enum": ["development_headers", "oidc_bearer"]},
        "allowInsecureDevelopmentHeaders": {"type": "boolean"},
        "oidc": {
          "type": "object",
          "required": ["issuerURL", "audience", "tenantClaim", "rolesClaim", "egressCIDRs", "port"],
          "properties": {
            "issuerURL": {"type": "string"},
            "audience": {"type": "string"},
            "tenantClaim": {"type": "string", "minLength": 1},
            "rolesClaim": {"type": "string", "minLength": 1},
            "egressCIDRs": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"}
            },
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["file", "postgres"]}
      }
    },
    "database": {
      "type": "object",
      "required": ["existingSecret", "migrationExistingSecret", "urlKey", "migrateOnDeploy"],
      "properties": {
        "existingSecret": {"type": "string"},
        "migrationExistingSecret": {"type": "string"},
        "urlKey": {"type": "string", "minLength": 1},
        "migrateOnDeploy": {"type": "boolean"}
      }
    },
    "gitlab": {
      "type": "object",
      "required": ["tenantID", "integrationID", "api"],
      "properties": {
        "tenantID": {"type": "string"},
        "integrationID": {"type": "string", "minLength": 1},
        "api": {
          "type": "object",
          "required": ["baseURL", "existingSecret", "tokenKey", "authMode", "secretReference", "egressCIDRs", "port"],
          "properties": {
            "baseURL": {"type": "string"},
            "existingSecret": {"type": "string"},
            "tokenKey": {"type": "string", "minLength": 1},
            "authMode": {"type": "string", "enum": ["private_token", "bearer"]},
            "secretReference": {"type": "string", "minLength": 1},
            "egressCIDRs": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]+$"}
            },
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      }
    }
  }
}
