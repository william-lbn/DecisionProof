{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisionproof.local/schemas/v2/agent-release-manifest.schema.json",
  "title": "Agent Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "agent_name", "agent_code_commit_sha", "provider", "model_id",
    "model_configuration_digest", "prompt_digest", "tool_catalog_digest",
    "policy_digest", "sandbox_profile_digest", "evaluation_suite_digest",
    "evaluation_evidence_ids", "allowed_capabilities", "manifest_digest"
  ],
  "properties": {
    "id": {"type": "string"},
    "agent_name": {"type": "string"},
    "agent_code_commit_sha": {"type": "string"},
    "provider": {"type": "string"},
    "model_id": {"type": "string"},
    "model_configuration_digest": {"type": "string", "pattern": "^sha256:"},
    "prompt_digest": {"type": "string", "pattern": "^sha256:"},
    "tool_catalog_digest": {"type": "string", "pattern": "^sha256:"},
    "mcp_servers": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:"}
    },
    "policy_digest": {"type": "string", "pattern": "^sha256:"},
    "retrieval_index_digest": {"type": "string", "pattern": "^sha256:"},
    "memory_schema_digest": {"type": "string", "pattern": "^sha256:"},
    "renderer_digest": {"type": "string", "pattern": "^sha256:"},
    "sandbox_profile_digest": {"type": "string", "pattern": "^sha256:"},
    "evaluation_suite_digest": {"type": "string", "pattern": "^sha256:"},
    "evaluation_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "allowed_capabilities": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "not": {"const": "*"}}
    },
    "created_by": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:"}
  }
}
