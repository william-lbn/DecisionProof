{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisionproof.local/schemas/v2/evidence.schema.json",
  "title": "生命周期证据 V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tenant_id", "change_id", "type", "schema_version", "subject_type", "subject_digest", "verdict", "trust_class", "payload_digest", "occurred_at"],
  "properties": {
    "id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "change_id": {"type": "string"},
    "type": {"type": "string"},
    "schema_version": {"type": "string"},
    "subject_type": {"type": "string"},
    "subject_id": {"type": "string"},
    "subject_digest": {"type": "string", "minLength": 1},
    "producer_identity": {"type": "string"},
    "source_system": {"type": "string"},
    "source_uri": {"type": "string"},
    "external_id": {"type": "string"},
    "verdict": {"type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE", "OBSERVED"]},
    "trust_class": {"type": "string", "enum": ["DECLARED", "OBSERVED", "VERIFIED", "ATTESTED", "HUMAN_APPROVED"]},
    "payload_digest": {"type": "string", "pattern": "^sha256:"},
    "object_uri": {"type": "string"},
    "supersedes_evidence_id": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "invalidated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
