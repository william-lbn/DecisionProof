{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisionproof.local/schemas/v2/product-decision.schema.json",
  "title": "产品决策对象",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id",
    "kind",
    "title",
    "origin",
    "status",
    "source_anchors",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "MARKET_SIGNAL",
        "CUSTOMER_INSIGHT",
        "OPPORTUNITY",
        "PROBLEM_STATEMENT",
        "BUSINESS_CASE",
        "PRODUCT_OBJECTIVE",
        "KEY_RESULT",
        "INITIATIVE",
        "ASSUMPTION",
        "DECISION_RECORD",
        "REQUIREMENT",
        "ACCEPTANCE_CRITERION",
        "NON_FUNCTIONAL_REQUIREMENT",
        "CONSTRAINT",
        "RISK",
        "DEPENDENCY",
        "OUT_OF_SCOPE",
        "ARCHITECTURE_DECISION",
        "OUTCOME_CONTRACT",
        "EXPERIMENT_HYPOTHESIS"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "content": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "EXTRACTED",
        "SUGGESTED",
        "CONFIRMED",
        "APPROVED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_anchors": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "block_id",
          "locator"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "block_id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "excerpt_digest": {
            "type": "string",
            "pattern": "^sha256:"
          }
        }
      }
    },
    "confirmed_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "type": "string",
      "enum": [
        "AI_EXTRACTED",
        "MANUAL",
        "IMPORTED"
      ]
    },
    "rejected_by": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "rejected_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
